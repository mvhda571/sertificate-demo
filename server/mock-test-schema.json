{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MathMockQuestion",
  "type": "object",
  "required": ["id", "question", "options", "correctOption", "subject", "year"],
  "properties": {
    "id": {"type": "string"},
    "question": {"type": "string", "minLength": 1},
    "questionImageUrl": {"type": ["string", "null"], "format": "uri"},
    "formulaHtml": {"type": ["string", "null"]},
    "options": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string"}},
    "correctOption": {"type": "integer", "minimum": 0, "maximum": 3},
    "subject": {"const": "Matematika"},
    "year": {"type": "integer", "minimum": 2025},
    "sourceUrl": {"type": "string", "format": "uri"}
  }
}
